{
  "manifest_version": 3,
  "name": "Stealth Overlay Bridge",
  "version": "4.0.0",
  "description": "Real-time AI interview copilot overlay — LockedIn AI style",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stealth Overlay Bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["options.html", "options.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
